{
  "name": "RotShift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": {
          "optional": "Packages"
        }
      },
      "Assets": {
        "$className": "Folder",
        "Brainrots": {
          "$path": {
            "optional": "assets/models"
          }
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": {
          "optional": "ServerPackages"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 3,
        "ClockTime": 14,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ShadowSoftness": 0.2
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "CelestialBodiesShown": true
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Offset": 0.1,
          "Haze": 0.6,
          "Glare": 0.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.6
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.04,
          "Spread": 0.6
        }
      }
    }
  }
}
